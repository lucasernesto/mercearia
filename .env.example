# Copie este arquivo para ".env" e ajuste os valores.
# O .env não vai para o git, então cada máquina tem o seu.

# Senha do painel /admin. Troque por uma senha forte.
MERCEARIA_ADMIN_SENHA=admin123

# Taxa de entrega em centavos (500 = R$ 5,00).
MERCEARIA_TAXA_ENTREGA_CENTAVOS=500

# 127.0.0.1 = só esta máquina. 0.0.0.0 = aceita celulares e computadores da mesma rede.
MERCEARIA_HOST=127.0.0.1
MERCEARIA_PORTA=5000

# 1 = modo de desenvolvimento do Flask (recarrega ao editar o código). Não use em produção.
FLASK_DEBUG=0
